  "blockedLiteralTranslations": {
    "animeGeneral": {
      "senior": "NO traducir automáticamente como 'senior' si el contexto es escolar/japonés; revisar si corresponde 'senpai' o 'alumno de curso superior'",
      "master": "NO fijar siempre como 'amo'; normalmente 'maestro' salvo contexto de servidumbre",
      "spirit": "NO fijar siempre como 'espíritu'; revisar si es energía, ánimo o entidad",
      "technique": "NO traducir como 'truco' en combate; usar 'técnica'"
    },
    "onePiece": {
      "Straw Hat": "NO traducir como 'sombrero de paja' cuando funcione como nombre de banda o apodo consolidado sin revisar contexto",
      "marine": "NO traducir automáticamente como 'marino'; normalmente 'marine' o fuerza naval según contexto",
      "gear": "NO traducir literalmente sin revisar si se refiere a la técnica de Luffy"
    },
    "soloLeveling": {
      "job": "NO traducir como 'trabajo' en contexto del Sistema; normalmente 'clase'",
      "shadow": "NO traducir siempre como 'sombra' aislada si forma parte de un título o habilidad",
      "gate": "NO traducir como 'puerta' en contexto de mazmorras; usar 'portal'",
      "ranker": "NO traducir de forma improvisada; revisar consistencia con 'cazador de alto rango' o término fijado"
    },
    "fantasy": {
      "party": "NO traducir como 'fiesta'; usar 'grupo'",
      "tank": "NO traducir como 'tanque' militar si es rol RPG; mantener 'tanque'",
      "dungeon": "NO traducir como 'calabozo' salvo que el tono lo pida; normalmente 'mazmorra'",
      "skill": "NO traducir como 'destreza' si el sistema usa 'habilidad'"
    },
    "military": {
      "chief": "NO traducir automáticamente como 'jefe' si es rango específico; revisar contexto",
      "commander": "NO traducir como 'mandamás'; usar 'comandante'",
      "unit": "NO traducir siempre como 'unidad' si se refiere a persona/equipo especial; revisar contexto"
    }
  }
